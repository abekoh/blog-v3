{
	"name": "blog-v3",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint . && prettier --check '**/*.{ts,tsx,astro,cjs,mjs}'",
		"lint:fix": "eslint --fix . && prettier --write '**/*.{ts,tsx,astro,cjs,mjs}'",
		"install:browsers": "playwright install chromium --with-deps",
		"test:e2e": "astro build && pagefind --site dist && playwright test",
		"test:e2e:snapshot": "astro build && pagefind --site dist && docker run --rm --network host -v $(pwd):/work/ -w /work/ --pull always -it mcr.microsoft.com/playwright:v1.64.1-noble /bin/bash -c 'npm i -g pnpm && pnpm playwright test --update-snapshots'"
	},
	"dependencies": {
		"@astrojs/mdx": "8.1.0",
		"@astrojs/prefetch": "0.4.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.2",
		"dayjs": "1.11.23",
		"github-slugger": "2.0.0",
		"marked": "18.1.1",
		"pagefind": "1.5.2",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@types/marked": "6.0.0",
		"@types/node": "24.19.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-astro": "1.7.0",
		"globals": "17.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0"
	},
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": "24.21.0"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	}
}
